	local speedMult = 1
	local jumpMult = 1
	local baseWalkSpeed = 16
	local baseJumpPower = 50

	CreateSlider(tabFrames.Player, "Speed Multiplier", 1, 50, 1, function(val)
		speedMult = val
		local char = LocalPlayer.Character
		if not char then
			return
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		hum.WalkSpeed = baseWalkSpeed * speedMult
	end)

	CreateSlider(tabFrames.Player, "Jump Multiplier", 1, 100, 1, function(val)
		jumpMult = val
		local char = LocalPlayer.Character
		if not char then
			return
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		hum.UseJumpPower = true
		hum.JumpPower = baseJumpPower * jumpMult
	end)

	LocalPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.5)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			baseWalkSpeed = hum.WalkSpeed
			baseJumpPower = hum.JumpPower
			hum.WalkSpeed = baseWalkSpeed * speedMult
			hum.JumpPower = baseJumpPower * jumpMult
		end
	end)

	local noclipEnabled = false
	local function applyNoclip(char)
		if not char then
			return
		end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = not noclipEnabled
			end
		end
	end

	RunService.Stepped:Connect(function()
		if noclipEnabled and LocalPlayer.Character then
			applyNoclip(LocalPlayer.Character)
		end
	end)

	CreateToggle(tabFrames.Player, "No-Clip", function(state)
		noclipEnabled = state
		if LocalPlayer.Character then
			applyNoclip(LocalPlayer.Character)
		end
	end)

