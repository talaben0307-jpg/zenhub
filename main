	topBar.Size = UDim2.new(1, 0, 0, 35)
	topBar.BackgroundColor3 = Color3.fromRGB(25, 25, 25)

	local topCorner = Instance.new("UICorner", topBar)
	topCorner.CornerRadius = UDim.new(0, 15)

	local titleLabel = Instance.new("TextLabel", topBar)
	titleLabel.Text = "VEXT HUB – Brookhaven V3"
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 16
	titleLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Position = UDim2.new(0, 15, 0, 0)
	titleLabel.Size = UDim2.new(1, -100, 1, 0)
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left

	local minBtn = Instance.new("TextButton", topBar)
	minBtn.Text = "–"
	minBtn.Size = UDim2.new(0, 30, 0, 25)
	minBtn.Position = UDim2.new(1, -70, 0, 5)
	minBtn.BackgroundColor3 = Color3.fromRGB(50, 0, 0)
	minBtn.TextColor3 = Color3.new(1, 1, 1)
	minBtn.Font = Enum.Font.GothamBold
	minBtn.TextSize = 22

	local minCorner = Instance.new("UICorner", minBtn)
	minCorner.CornerRadius = UDim.new(0, 8)

	local closeBtn = Instance.new("TextButton", topBar)
	closeBtn.Text = "X"
	closeBtn.Size = UDim2.new(0, 30, 0, 25)
	closeBtn.Position = UDim2.new(1, -35, 0, 5)
	closeBtn.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
	closeBtn.TextColor3 = Color3.new(1, 1, 1)
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextSize = 18

	local closeCorner = Instance.new("UICorner", closeBtn)
	closeCorner.CornerRadius = UDim.new(0, 8)

	local function makeDraggable(dragTrigger, targetFrame)
		local dragging = false
		local dragInput, dragStart, startPos

		dragTrigger.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = targetFrame.Position

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		dragTrigger.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if input == dragInput and dragging then
				local delta = input.Position - dragStart
				targetFrame.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end)
	end

	makeDraggable(topBar, mainFrame)

	closeBtn.MouseButton1Click:Connect(function()
		local overlay = Instance.new("Frame", mainFrame)
		overlay.Size = UDim2.new(1, 0, 1, 0)
		overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		overlay.BackgroundTransparency = 1
		overlay.ZIndex = 1000
		overlay.Active = true

		local dialog = Instance.new("Frame", overlay)
		dialog.Size = UDim2.new(0, 230, 0, 130)
		dialog.Position = UDim2.new(0.5, -115, 0.5, -65)
		dialog.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		dialog.BorderSizePixel = 0
		dialog.BackgroundTransparency = 1
		dialog.ZIndex = 1001

		local dialogCorner = Instance.new("UICorner", dialog)
		dialogCorner.CornerRadius = UDim.new(0, 12)

		local dialogStroke = Instance.new("UIStroke", dialog)
		dialogStroke.Color = Color3.fromRGB(140, 25, 25)
		dialogStroke.Thickness = 1.6

		local promptLabel = Instance.new("TextLabel", dialog)
		promptLabel.Text = "¿Close menu?"
		promptLabel.Font = Enum.Font.GothamBold
		promptLabel.TextSize = 16
		promptLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		promptLabel.BackgroundTransparency = 1
		promptLabel.Size = UDim2.new(1, 0, 0, 40)
		promptLabel.Position = UDim2.new(0, 0, 0, 10)
		promptLabel.ZIndex = 1001

		local yesBtn = Instance.new("TextButton", dialog)
		yesBtn.Text = "Yes"
		yesBtn.Font = Enum.Font.GothamBold
		yesBtn.TextSize = 14
		yesBtn.TextColor3 = Color3.new(1, 1, 1)
		yesBtn.BackgroundColor3 = Color3.fromRGB(150, 30, 30)
		yesBtn.Size = UDim2.new(0.45, -10, 0, 35)
		yesBtn.Position = UDim2.new(0.05, 0, 0.65, 0)
		yesBtn.ZIndex = 1001

		local yesCorner = Instance.new("UICorner", yesBtn)
		yesCorner.CornerRadius = UDim.new(0, 8)

		local noBtn = Instance.new("TextButton", dialog)
		noBtn.Text = "No"
		noBtn.Font = Enum.Font.GothamBold
		noBtn.TextSize = 14
		noBtn.TextColor3 = Color3.new(1, 1, 1)
		noBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		noBtn.Size = UDim2.new(0.45, -10, 0, 35)
		noBtn.Position = UDim2.new(0.5, 10, 0.65, 0)
		noBtn.ZIndex = 1001

		local noCorner = Instance.new("UICorner", noBtn)
		noCorner.CornerRadius = UDim.new(0, 8)

		local tInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(overlay, tInfo, { BackgroundTransparency = 0.4 }):Play()
		TweenService:Create(dialog, tInfo, { BackgroundTransparency = 0 }):Play()

		yesBtn.MouseButton1Click:Connect(function()
			local t1 = TweenService:Create(overlay, tInfo, { BackgroundTransparency = 1 })
			local t2 = TweenService:Create(dialog, tInfo, { BackgroundTransparency = 1 })
			t1:Play()
			t2:Play()
			t2.Completed:Connect(function()
				screenGui:Destroy()
			end)
		end)

		noBtn.MouseButton1Click:Connect(function()
			local t1 = TweenService:Create(overlay, tInfo, { BackgroundTransparency = 1 })
			local t2 = TweenService:Create(dialog, tInfo, { BackgroundTransparency = 1 })
			t1:Play()
			t2:Play()
			t2.Completed:Connect(function()
				overlay:Destroy()
			end)
		end)
	end)

	local function addRainbowStroke(obj)
		local stroke = Instance.new("UIStroke", obj)
		stroke.Thickness = 3
		stroke.LineJoinMode = Enum.LineJoinMode.Round
		local hue = 0
		local conn
		conn = RunService.RenderStepped:Connect(function()
			if not obj or not obj.Parent then
				conn:Disconnect()
				return
			end
			hue = (hue + 0.005) % 1
			stroke.Color = Color3.fromHSV(hue, 1, 1)
		end)
	end

	local miniCircle = nil
	local isMinimized = false

	local function createMiniCircle()
		if miniCircle then
			return
		end
		miniCircle = Instance.new("ImageButton", screenGui)
		miniCircle.Name = "MiniCircle"
		miniCircle.Size = UDim2.new(0, 48, 0, 48)
		miniCircle.Position = UDim2.new(0, 10, 0.5, -24)
		miniCircle.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		miniCircle.BackgroundTransparency = 0
		miniCircle.Image = "rbxassetid://0"

		pcall(function()
			if writefile and getcustomasset then
				local imgPath = folderName .. "/mini_icon.jpg"
				if not isfile(imgPath) then
					local data = game:HttpGet("https://i.ibb.co/VYQTJFp0/IMG-20250812-184530.jpg")
					writefile(imgPath, data)
				end
				miniCircle.Image = getcustomasset(imgPath)
			end
		end)

		local cCorner = Instance.new("UICorner", miniCircle)
		cCorner.CornerRadius = UDim.new(1, 0)

		addRainbowStroke(miniCircle)
		makeDraggable(miniCircle, miniCircle)

		miniCircle.MouseButton1Click:Connect(function()
			isMinimized = false
			if miniCircle then
				miniCircle:Destroy()
				miniCircle = nil
			end
			mainFrame.Visible = true
			local tInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(mainFrame, tInfo, { Size = UDim2.new(0, 520, 0, 340) }):Play()
		end)
	end

	minBtn.MouseButton1Click:Connect(function()
		isMinimized = not isMinimized
		if isMinimized then
			mainFrame.Visible = false
			createMiniCircle()
		else
			if miniCircle then
				miniCircle:Destroy()
				miniCircle = nil
			end
			mainFrame.Visible = true
		end
	end)

