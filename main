	CreateButton(tabFrames.Home, "Unban All Houses (Full Deep Scan)", function()
		local count = 0
		for i = 1, 37 do
			local b = workspace:FindFirstChild("BannedBlock" .. i, true)
			if b then
				pcall(function()
					b:Destroy()
					count = count + 1
				end)
			end
		end
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj.Name:match("BannedBlock") then
				pcall(function()
					obj:Destroy()
					count = count + 1
				end)
			end
		end
		if count > 0 then
			notify("Removed " .. tostring(count) .. " house bans!")
		else
			notify("No banned houses found.")
