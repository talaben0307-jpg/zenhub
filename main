	local function safeReturnPos()
		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then
			return
		end
		hum.PlatformStand = true
		hrp.Anchored = true
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(1118.81, 75.998, -1138.61)
		task.wait(1.5)
		hrp.Anchored = false
		hum.PlatformStand = false
	end

	CreateButton(tabFrames.Troll, "Press! Fast - Fling (Couch)", function()
		local tName = getgenv and getgenv().Target
		local target = tName and Players:FindFirstChild(tName)
		if not target or not target.Character then
			notify("Valid target required!")
			return
		end

		local myChar = LocalPlayer.Character
		local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp or not tHrp then
			return
		end

		local bp = LocalPlayer:FindFirstChild("Backpack")
		local couch = bp and bp:FindFirstChild("Couch")
		if couch and not myChar:FindFirstChild("Couch") then
			hum:EquipTool(couch)
		end

		local oldCFrame = hrp.CFrame
		workspace.FallenPartsDestroyHeight = -math.huge

		local bv = Instance.new("BodyVelocity", hrp)
		bv.Velocity = Vector3.new(1000, 1000, 1000)
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

		local startTick = tick()
		while tick() - startTick < 3 and target.Character and target.Character:FindFirstChild("HumanoidRootPart") do
			local curTHrp = target.Character.HumanoidRootPart
			if target.Character:FindFirstChildWhichIsA("Seat") then
				break
			end
			hrp.CFrame = CFrame.new(curTHrp.Position) * CFrame.new(0, 2, 0) * CFrame.Angles(math.rad(100), 0, 0)
			task.wait()
			hrp.CFrame = CFrame.new(curTHrp.Position) * CFrame.new(0, -2, 0) * CFrame.Angles(math.rad(-100), 0, 0)
			task.wait()
		end

		bv:Destroy()
		hum.PlatformStand = true
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = oldCFrame
		task.wait(0.5)
		hum.PlatformStand = false
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	end)

	CreateSection(tabFrames.Troll, "Menu Kill Car")

	local busFlingActive = false

	local function spawnAndSitSchoolBus()
		local myChar = LocalPlayer.Character
		local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local vehicles = workspace:FindFirstChild("Vehicles")
		if not hum or not hrp or not vehicles then
			return nil
		end

		local myCar = vehicles:FindFirstChild(LocalPlayer.Name .. "Car")
		if not myCar then
			hrp.CFrame = CFrame.new(1118.81, 75.998, -1138.61)
			task.wait(0.5)
			local carRem = ReplicatedStorage:FindFirstChild("RE") and ReplicatedStorage.RE:FindFirstChild("1Ca1r")
			if carRem then
				carRem:FireServer("PickingCar", "SchoolBus")
			end
			for _ = 1, 20 do
				task.wait(0.25)
				myCar = vehicles:FindFirstChild(LocalPlayer.Name .. "Car")
				if myCar then
					break
				end
			end
		end

		if not myCar then
			return nil
		end

		task.wait(0.4)
		local seat = myCar:FindFirstChild("Body") and myCar.Body:FindFirstChild("VehicleSeat")
		if seat and not hum.Sit then
			local t = tick()
			while not hum.Sit and tick() - t < 3 do
				hrp.CFrame = seat.CFrame
				task.wait()
			end
		end
		return myCar
	end

	CreateButton(tabFrames.Troll, "Fling Bus", function()
		local tName = getgenv and getgenv().Target
		local target = tName and Players:FindFirstChild(tName)
		if not target or not target.Character then
			notify("Select a target first!")
			return
		end

		busFlingActive = true
		local myCar = spawnAndSitSchoolBus()
		if not myCar then
			notify("Could not spawn SchoolBus!")
			return
		end

		for _, part in ipairs(myCar:GetDescendants()) do
			if part:IsA("BasePart") then
				local bv = Instance.new("BodyVelocity", part)
				bv.Name = "ZenxBusVel"
				bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
				bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				bv.P = 500
			end
		end

		task.spawn(function()
			local offsets = {
				Vector3.new(0, 1, 0),
				Vector3.new(0, -2.25, 5),
				Vector3.new(0, 2.25, 0.25),
				Vector3.new(-2.25, -1.5, 2.25),
				Vector3.new(0, 1.5, 0),
				Vector3.new(0, -1.5, 0)
			}
			while busFlingActive and myCar and myCar.Parent do
				local tChar = target.Character
				local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
				local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
				if tHum and tHrp then
					local rot = CFrame.Angles(math.rad(100), math.rad(5000), 0)
					for _, off in ipairs(offsets) do
						if not busFlingActive or not myCar.Parent then
							break
						end
						local pos = tHrp.Position + off + (tHum.MoveDirection * tHrp.Velocity.Magnitude / 1.1)
						pcall(function()
							myCar:SetPrimaryPartCFrame(CFrame.new(pos) * rot)
						end)
						task.wait()
					end
				else
					task.wait(0.2)
				end
			end
		end)
	end)

	CreateButton(tabFrames.Troll, "Off Fling Bus", function()
		busFlingActive = false
		pcall(function()
			local carRem = ReplicatedStorage:FindFirstChild("RE") and ReplicatedStorage.RE:FindFirstChild("1Ca1r")
			if carRem then
				carRem:FireServer("DeleteAllVehicles")
			end
		end)
		task.wait(0.2)
		safeReturnPos()
		notify("Bus Fling stopped!")
	end)

	CreateButton(tabFrames.Troll, "Car Kill (Void)", function()
		local tName = getgenv and getgenv().Target
		local target = tName and Players:FindFirstChild(tName)
		if not target or not target.Character then
			notify("Select a target first!")
			return
		end

		local myChar = LocalPlayer.Character
		local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp then
			return
		end
		local savedPos = hrp.CFrame

		local myCar = spawnAndSitSchoolBus()
		if not myCar then
			return
		end

		local tChar = target.Character
		local tHum = tChar:FindFirstChildOfClass("Humanoid")
		local tHrp = tChar:FindFirstChild("HumanoidRootPart")
		if not tHum or not tHrp then
			return
		end

		local startT = tick()
		while not tHum.Sit and tick() - startT < 4 and myCar.Parent do
			local rot = CFrame.Angles(math.rad(100), math.rad(5000), 0)
			local pos = tHrp.Position + (tHum.MoveDirection * tHrp.Velocity.Magnitude / 1.05)
			pcall(function()
				myCar:SetPrimaryPartCFrame(CFrame.new(pos) * rot)
			end)
			task.wait()
		end

		if tHum.Sit then
			pcall(function()
				myCar:SetPrimaryPartCFrame(CFrame.new(0, -450, 0))
			end)
			task.wait(0.3)
			hum.Sit = false
			task.wait(0.2)
			hrp.CFrame = savedPos
			notify("Target dropped to void!")
		end
	end)

	CreateButton(tabFrames.Troll, "Bring Target (Car)", function()
		local tName = getgenv and getgenv().Target
