			local seats = myCar and myCar:FindFirstChild("Seats")
			if seats then
				for _, seat in ipairs(seats:GetChildren()) do
					if seat:IsA("VehicleSeat") then
						local ms = seat:FindFirstChild("MaxSpeed")
						local tb = seat:FindFirstChild("Turbo")
						if ms and tb then
							if not editingVehicle.speed then
								speedBox.Text = tostring(ms.Value)
							end
							if not editingVehicle.turbo then
								turboBox.Text = tostring(tb.Value)
							end
						end
					end
				end
			end
		end
	end)

