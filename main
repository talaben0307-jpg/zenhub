	CreateSection(tabFrames.Troll, "Target & View")
	local viewingActive = false
	local viewedPlayer = nil
	local viewCharConn = nil
	local loopGotoConn = nil

	local function findPlayerByPartial(str)
		if typeof(str) ~= "string" or #str == 0 then
			return nil
		end
		local lower = str:lower()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				if p.Name:lower():sub(1, #lower) == lower or p.DisplayName:lower():sub(1, #lower) == lower then
					return p
				end
			end
		end
		return nil
	end

	local function resetCamera()
		if LocalPlayer.Character then
			local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				Camera.CameraSubject = hum
			end
		end
	end

	local function setViewTarget(name)
		local p = Players:FindFirstChild(name)
		if not p then
			notify("Player not found!")
			return
		end
		viewedPlayer = p
		if viewCharConn then
			viewCharConn:Disconnect()
		end
		viewCharConn = p.CharacterAdded:Connect(function(char)
			task.wait(0.1)
			if viewingActive and viewedPlayer == p then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					Camera.CameraSubject = hum
				end
			end
		end)
		if p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				Camera.CameraSubject = hum
			end
		end
	end

	local function stopViewing()
		viewingActive = false
		viewedPlayer = nil
		if viewCharConn then
			viewCharConn:Disconnect()
			viewCharConn = nil
		end
		resetCamera()
	end

	RunService.RenderStepped:Connect(function()
		if viewingActive and viewedPlayer then
			if not viewedPlayer:IsDescendantOf(game) then
				stopViewing()
				return
			end
			if viewedPlayer.Character then
				local hum = viewedPlayer.Character:FindFirstChildOfClass("Humanoid")
				if hum and Camera.CameraSubject ~= hum then
					Camera.CameraSubject = hum
				end
			end
		end
	end)

	CreateTextBox(tabFrames.Troll, "Select Player", "Partial Name...", function(txt)
		local found = findPlayerByPartial(txt)
		if found then
			if getgenv then
				getgenv().Target = found.Name
			end
			notify("Target: " .. found.Name)
			if viewingActive then
				setViewTarget(found.Name)
			end
		else
			notify("No player found!")
		end
	end)

	CreateToggle(tabFrames.Troll, "View Target", function(state)
		viewingActive = state
		if state then
			local tName = getgenv and getgenv().Target
			if tName then
				setViewTarget(tName)
			else
				notify("Select a target first!")
			end
		else
			stopViewing()
		end
	end)

	CreateButton(tabFrames.Troll, "Goto Target", function()
		local tName = getgenv and getgenv().Target
		if not tName then
			notify("Select a target first!")
			return
		end
		local target = Players:FindFirstChild(tName)
		local myChar = LocalPlayer.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local tHrp = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		if myHrp and tHrp then
			local tInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(myHrp, tInfo, { CFrame = tHrp.CFrame + Vector3.new(2, 0, 2) }):Play()
		end
	end)

	CreateToggle(tabFrames.Troll, "Loop Goto", function(state)
		if state then
			loopGotoConn = RunService.Stepped:Connect(function()
				local tName = getgenv and getgenv().Target
				local target = tName and Players:FindFirstChild(tName)
				local tHrp = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if myHrp and tHrp then
					myHrp.CFrame = tHrp.CFrame + Vector3.new(2, 0, 2)
				end
			end)
		else
			if loopGotoConn then
				loopGotoConn:Disconnect()
				loopGotoConn = nil
			end
		end
	end)

