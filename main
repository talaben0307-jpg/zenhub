	local function getIconAsset(url, fileName)
		if string.sub(url, 1, 13) == "rbxassetid://" then
			return url
		end
		local fullPath = folderName .. "/" .. fileName
		local asset = ""
		pcall(function()
			if isfile and writefile and getcustomasset then
				if not isfile(fullPath) then
					local res = game:HttpGet(url, true)
					writefile(fullPath, res)
				end
				asset = getcustomasset(fullPath)
			end
		end)
		return asset
	end

	local tabCount = 0
	local tabButtons = {}
	local tabLabels = {}
	local tabFrames = {}

	local function createTab(name, iconUrl, iconFile, isDefault)
		tabCount = tabCount + 1
		local btn = Instance.new("TextButton", sidebar)
		btn.Size = UDim2.new(1, 0, 0, 40)
		btn.LayoutOrder = tabCount
		btn.BackgroundTransparency = 1
		btn.Text = ""
		tabButtons[name] = btn

		local icon = Instance.new("ImageLabel", btn)
		icon.Size = UDim2.new(0, 24, 0, 24)
		icon.Position = UDim2.new(0, 5, 0.5, -12)
		icon.BackgroundTransparency = 1
		icon.Image = getIconAsset(iconUrl, iconFile)
		icon.ImageColor3 = Color3.fromRGB(0, 255, 255)

		local lbl = Instance.new("TextLabel", btn)
		lbl.Size = UDim2.new(1, -35, 1, 0)
		lbl.Position = UDim2.new(0, 35, 0, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = name
		lbl.TextColor3 = Color3.fromRGB(220, 230, 255)
		lbl.Font = Enum.Font.Gotham
		lbl.TextSize = 14
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		tabLabels[name] = lbl

		local page = Instance.new("Frame", contentContainer)
		page.Size = UDim2.new(1, 0, 0, 0)
		page.AutomaticSize = Enum.AutomaticSize.Y
		page.BackgroundTransparency = 1
		page.Visible = false
		tabFrames[name] = page

		local layout = Instance.new("UIListLayout", page)
		layout.Padding = UDim.new(0, 10)
		layout.SortOrder = Enum.SortOrder.LayoutOrder

		local padding = Instance.new("UIPadding", page)
		padding.PaddingTop = UDim.new(0, 10)
		padding.PaddingLeft = UDim.new(0, 10)
		padding.PaddingRight = UDim.new(0, 10)
		padding.PaddingBottom = UDim.new(0, 10)

		local function selectTab()
			for k, v in pairs(tabFrames) do
				v.Visible = false
				if tabLabels[k] then
					tabLabels[k].TextColor3 = Color3.fromRGB(220, 230, 255)
				end
			end
			page.Visible = true
			lbl.TextColor3 = Color3.fromRGB(0, 255, 255)
		end

		btn.MouseButton1Click:Connect(selectTab)
		if isDefault then
			selectTab()
		end
	end

	local function CreateSection(parent, title)
		local sec = Instance.new("TextLabel", parent)
		sec.Size = UDim2.new(1, 0, 0, 24)
		sec.BackgroundTransparency = 1
		sec.Text = "◆ " .. string.upper(title)
		sec.Font = Enum.Font.GothamBold
		sec.TextSize = 13
		sec.TextColor3 = Color3.fromRGB(255, 0, 128)
		sec.TextXAlignment = Enum.TextXAlignment.Left
		return sec
	end

	local function CreateButton(parent, text, callback)
		local btn = Instance.new("TextButton", parent)
		btn.Size = UDim2.new(1, 0, 0, 35)
		btn.BackgroundColor3 = Color3.fromRGB(28, 18, 58)
		btn.Text = text
