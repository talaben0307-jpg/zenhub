	local function collectCandies(difficulty, folderNameTarget, label)
		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		if not hrp then
			return
		end

		pcall(function()
			ReplicatedStorage.Remotes.ChangeDifficulty:FireServer(difficulty)
		end)

		local folder = workspace:FindFirstChild(folderNameTarget) or workspace:WaitForChild(folderNameTarget, 5)
		if not folder then
			notify("Event folder not found!")
			return
		end

		local items = folder:GetChildren()
		local collected = 0
		for _, item in ipairs(items) do
			if item:IsA("BasePart") or item:IsA("MeshPart") then
				local startTick = tick()
				while item and item.Parent and hrp and hrp.Parent and (tick() - startTick < 5) do
					hrp.CFrame = CFrame.new(item.Position + Vector3.new(0, 5, 0))
					RunService.Heartbeat:Wait()
				end
				collected = collected + 1
			end
		end
		notify("Collected " .. tostring(collected) .. "/" .. tostring(#items) .. " " .. label .. "!")
	end

