			task.wait(1)
			local vehiclesFolder = workspace:FindFirstChild("Vehicles")
			local myCar = vehiclesFolder and vehiclesFolder:FindFirstChild(LocalPlayer.Name .. "Car")
			local seats = myCar and myCar:FindFirstChild("Seats")
			if seats then
				for _, seat in ipairs(seats:GetChildren()) do
					if seat:IsA("VehicleSeat") then
						local ms = seat:FindFirstChild("MaxSpeed")
						local tb = seat:FindFirstChild("Turbo")
						if ms and tb then
							if not editingVehicle.speed then
								speedBox.Text = tostring(ms.Value)
							end
							if not editingVehicle.turbo then
								turboBox.Text = tostring(tb.Value)
							end
						end
					end
				end
			end
		end
	end)

	CreateSection(tabFrames.Avatar, "Copy Player Outfit")
	local selectedCopyPlayer = nil
	local function getPlayerNamesList()
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				table.insert(list, p.Name)
			end
		end
		return list
	end

	local copyDropdown = CreateDropdown(tabFrames.Avatar, "Player", getPlayerNamesList(), nil, function(opt)
		selectedCopyPlayer = opt
	end)

	Players.PlayerAdded:Connect(function()
		copyDropdown.Refresh(getPlayerNamesList())
	end)
	Players.PlayerRemoving:Connect(function()
		copyDropdown.Refresh(getPlayerNamesList())
	end)

	CreateButton(tabFrames.Avatar, "Copy Selected Avatar", function()
		if not selectedCopyPlayer then
			notify("Select a player to copy!")
			return
		end
		local target = Players:FindFirstChild(selectedCopyPlayer)
		local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		local tHum = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		if not myHum or not tHum or not remotes then
			return
		end

		pcall(function()
			local myDesc = myHum:GetAppliedDescription()
			for _, acc in ipairs(myDesc:GetAccessories(true)) do
				if acc.AssetId and tonumber(acc.AssetId) then
					remotes.Wear:InvokeServer(tonumber(acc.AssetId))
					task.wait(0.15)
				end
			end

			local tDesc = tHum:GetAppliedDescription()
			remotes.ChangeCharacterBody:InvokeServer({
				tDesc.Torso,
				tDesc.RightArm,
				tDesc.LeftArm,
				tDesc.RightLeg,
				tDesc.LeftLeg,
				tDesc.Head
			})
			task.wait(0.3)

			if tonumber(tDesc.Shirt) then
				remotes.Wear:InvokeServer(tonumber(tDesc.Shirt))
				task.wait(0.2)
			end
			if tonumber(tDesc.Pants) then
				remotes.Wear:InvokeServer(tonumber(tDesc.Pants))
				task.wait(0.2)
			end
			if tonumber(tDesc.Face) then
				remotes.Wear:InvokeServer(tonumber(tDesc.Face))
				task.wait(0.2)
			end
			for _, acc in ipairs(tDesc:GetAccessories(true)) do
				if acc.AssetId and tonumber(acc.AssetId) then
					remotes.Wear:InvokeServer(tonumber(acc.AssetId))
					task.wait(0.2)
				end
			end
		end)
		notify("Avatar copied from " .. selectedCopyPlayer)
	end)

