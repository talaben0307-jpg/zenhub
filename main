	confirmVehBtn.MouseButton1Click:Connect(function()
		local vehiclesFolder = workspace:FindFirstChild("Vehicles")
		local myCar = vehiclesFolder and vehiclesFolder:FindFirstChild(LocalPlayer.Name .. "Car")
		if not myCar then
			notify("Your vehicle was not found")
			return
		end

		local seats = myCar:FindFirstChild("Seats")
		if not seats then
			notify("No seats found")
			return
		end

		local sVal = tonumber(speedBox.Text)
		local tVal = tonumber(turboBox.Text)
		if not sVal or not tVal then
			notify("⚠ Enter valid numbers")
			return
		end

		for _, seat in ipairs(seats:GetChildren()) do
			if seat:IsA("VehicleSeat") then
				local ms = seat:FindFirstChild("MaxSpeed")
				local tb = seat:FindFirstChild("Turbo")
				if ms and tb then
					ms.Value = sVal
					tb.Value = tVal
				end
			end
		end
		notify("Updated values")
	end)

	local editingVehicle = { speed = false, turbo = false }
	speedBox.Focused:Connect(function()
		editingVehicle.speed = true
	end)
	speedBox.FocusLost:Connect(function()
		editingVehicle.speed = false
	end)
	turboBox.Focused:Connect(function()
		editingVehicle.turbo = true
	end)
	turboBox.FocusLost:Connect(function()
		editingVehicle.turbo = false
	end)

