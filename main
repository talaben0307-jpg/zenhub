					pcall(function()
						local myHouse = workspace["001_Lots"]:FindFirstChild(LocalPlayer.Name .. "House")
						local cf = myHouse and myHouse.HousePickedByPlayer.HouseModel["001_BBQ"]:FindFirstChild("CatchFire")
						local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						if cf and hrp and firetouchinterest then
							firetouchinterest(hrp, cf, 0)
							task.wait()
							firetouchinterest(hrp, cf, 1)
						end
					end)
					task.wait(1)
				end
			end)
		end
	end)

	CreateButton(tabFrames.Avatar, "Get Hospital Pool Trail", function()
		pcall(function()
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local poolClick = workspace.WorkspaceCom["001_Hospital"]:FindFirstChild("PoolClick")
			local cd = poolClick and poolClick:FindFirstChild("ClickDetector")
			if hum and hrp and poolClick and cd and fireclickdetector then
				local savedPos = hrp.CFrame
				hrp.CFrame = poolClick.CFrame
				task.wait(0.4)
				fireclickdetector(cd)
				task.wait(0.5)
				hrp.CFrame = savedPos
				notify("Trail activated!")
			end
		end)
	end)

	CreateSection(tabFrames.Avatar, "Special Accessories")
	local function wearAccessory(id, name)
		pcall(function()
			ReplicatedStorage.Remotes.Wear:InvokeServer(id)
		end)
		notify(name .. " Equipped")
	end

	CreateButton(tabFrames.Avatar, "Equip Headless", function()
		wearAccessory(134082579, "Headless")
	end)
	CreateButton(tabFrames.Avatar, "Equip 8-Bit HP Bar", function()
		wearAccessory(10159610478, "8-Bit HP Bar")
	end)
	CreateButton(tabFrames.Avatar, "Equip 8-Bit Royal Crown", function()
		wearAccessory(10159600649, "8-Bit Royal Crown")
	end)
	CreateButton(tabFrames.Avatar, "Equip Bluesteel Horns", function()
		wearAccessory(233705354, "Bluesteel Horns")
	end)
	CreateButton(tabFrames.Avatar, "Equip Halloween Hammer", function()
		wearAccessory(126059920065651, "Halloween Hammer")
	end)
	CreateButton(tabFrames.Avatar, "Equip Forbidden Crown of the Fallen", function()
		wearAccessory(13043987545, "Forbidden Crown of the Fallen")
	end)
	CreateButton(tabFrames.Avatar, "Equip Static Golden Halo", function()
		wearAccessory(13435004209, "Static Golden Halo")
	end)

	CreateSection(tabFrames["ESP & Shaders"], "Player ESP & Highlight")
	local espEnabled = false
	local espColor = Color3.fromRGB(0, 255, 255)
	local espRainbow = false

	local espColorMap = {
		["Cyan (Cyber)"] = Color3.fromRGB(0, 255, 255),
		["Magenta (Cyber)"] = Color3.fromRGB(255, 0, 128),
		["Blue"] = Color3.fromRGB(0, 100, 255),
		["Red"] = Color3.fromRGB(255, 0, 0),
		["Green"] = Color3.fromRGB(0, 255, 0),
		["Yellow"] = Color3.fromRGB(255, 255, 0),
		["Purple"] = Color3.fromRGB(160, 0, 255),
		["White"] = Color3.fromRGB(255, 255, 255),
		["Rainbow"] = nil
	}

	local function removeEspFromPlayer(p)
		if p and p.Character then
			local hi = p.Character:FindFirstChild("ESP_Highlight")
			if hi then
				hi:Destroy()
			end
			local bi = p.Character:FindFirstChild("ESP_Info")
			if bi then
				bi:Destroy()
			end
		end
	end

	local function applyEspToPlayer(p)
		if p == LocalPlayer or not p.Character then
			return
		end
		local hrp = p.Character:FindFirstChild("HumanoidRootPart")
		local hum = p.Character:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then
			return
		end
		removeEspFromPlayer(p)

		local hi = Instance.new("Highlight")
		hi.Name = "ESP_Highlight"
		hi.Adornee = p.Character
		hi.FillColor = espColor
		hi.FillTransparency = 0.5
		hi.OutlineColor = Color3.fromRGB(0, 0, 0)
		hi.OutlineTransparency = 0
		hi.Parent = p.Character

		local bGui = Instance.new("BillboardGui")
		bGui.Name = "ESP_Info"
		bGui.Adornee = hrp
		bGui.Size = UDim2.new(0, 150, 0, 55)
		bGui.StudsOffset = Vector3.new(0, 3, 0)
		bGui.AlwaysOnTop = true
		bGui.Parent = p.Character

		local function makeEspLine(yScale, text)
			local l = Instance.new("TextLabel", bGui)
			l.Size = UDim2.new(1, 0, 0.25, 0)
			l.Position = UDim2.new(0, 0, yScale, 0)
			l.BackgroundTransparency = 1
			l.Text = text
			l.TextColor3 = espColor
			l.TextStrokeTransparency = 0
			l.TextStrokeColor3 = Color3.new(0, 0, 0)
			l.TextScaled = true
			l.Font = Enum.Font.Code
			return l
		end

		local lName = makeEspLine(0, p.Name)
		local lDist = makeEspLine(0.25, "Dist: ...")
		local lAge = makeEspLine(0.5, "Age: " .. tostring(p.AccountAge) .. "d")
		local lHp = makeEspLine(0.75, "HP: " .. tostring(math.floor(hum.Health)))

		task.spawn(function()
			while espEnabled and p and p.Character and bGui.Parent do
				local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local curHrp = p.Character:FindFirstChild("HumanoidRootPart")
				local curHum = p.Character:FindFirstChildOfClass("Humanoid")
				if myHrp and curHrp and curHum then
					local d = (curHrp.Position - myHrp.Position).Magnitude
					lDist.Text = string.format("Dist: %.1f", d)
					lHp.Text = "HP: " .. tostring(math.floor(curHum.Health)) .. (curHum.Sit and " [Sit]" or "")
					hi.FillColor = espColor
					lName.TextColor3 = espColor
					lDist.TextColor3 = espColor
					lAge.TextColor3 = espColor
					lHp.TextColor3 = espColor
				end
				task.wait(0.15)
			end
		end)
	end

	CreateToggle(tabFrames["ESP & Shaders"], "Enable ESP", function(state)
		espEnabled = state
		if state then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					applyEspToPlayer(p)
				end
			end
		else
			for _, p in ipairs(Players:GetPlayers()) do
				removeEspFromPlayer(p)
			end
		end
	end)

	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			task.wait(0.5)
			if espEnabled then
				applyEspToPlayer(p)
			end
		end)
	end)

	local espColorNames = { "Cyan (Cyber)", "Magenta (Cyber)", "Blue", "Red", "Green", "Yellow", "Purple", "White", "Rainbow" }
	CreateDropdown(tabFrames["ESP & Shaders"], "ESP Color", espColorNames, "Cyan (Cyber)", function(opt)
		if opt == "Rainbow" then
			espRainbow = true
			task.spawn(function()
				while espRainbow do
					local h = (tick() * 0.3) % 1
					espColor = Color3.fromHSV(h, 1, 1)
					task.wait(0.1)
				end
			end)
		else
			espRainbow = false
			if espColorMap[opt] then
				espColor = espColorMap[opt]
			end
		end
	end)

	CreateSection(tabFrames["ESP & Shaders"], "Lighting & Shaders")
	CreateToggle(tabFrames["ESP & Shaders"], "Shaders", function(state)
		if state then
			local bloom = Instance.new("BloomEffect", Lighting)
			bloom.Name = "ZenxShader"
			bloom.Intensity = 0.5
			bloom.Size = 24
			bloom.Threshold = 1

			local cc = Instance.new("ColorCorrectionEffect", Lighting)
			cc.Name = "ZenxShader"
			cc.Brightness = 0.1
			cc.Contrast = 0.2
			cc.Saturation = 0.25
			cc.TintColor = Color3.fromRGB(255, 245, 230)

			local dof = Instance.new("DepthOfFieldEffect", Lighting)
			dof.Name = "ZenxShader"
			dof.FocusDistance = 50
			dof.InFocusRadius = 20
			dof.NearIntensity = 0.5
			dof.FarIntensity = 0.5

			local sun = Instance.new("SunRaysEffect", Lighting)
			sun.Name = "ZenxShader"
			sun.Intensity = 0.2
			sun.Spread = 0.5

			local sky = Instance.new("Sky", Lighting)
			sky.Name = "ZenxShader"
			sky.SkyboxBk = "rbxassetid://13758018253"
			sky.SkyboxDn = "rbxassetid://13758018253"
			sky.SkyboxFt = "rbxassetid://13758018253"
			sky.SkyboxLf = "rbxassetid://13758018253"
			sky.SkyboxRt = "rbxassetid://13758018253"
			sky.SkyboxUp = "rbxassetid://13758018253"

			Lighting.ShadowSoftness = 0.2
			Lighting.Ambient = Color3.fromRGB(150, 150, 150)
			Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
			Lighting.FogColor = Color3.fromRGB(200, 200, 210)
			Lighting.FogStart = 0
			Lighting.FogEnd = 1000
		else
			for _, child in ipairs(Lighting:GetChildren()) do
				if child.Name == "ZenxShader" or child:IsA("BloomEffect") or child:IsA("ColorCorrectionEffect") or child:IsA("DepthOfFieldEffect") or child:IsA("SunRaysEffect") or child:IsA("Sky") then
					child:Destroy()
				end
			end
			Lighting.ShadowSoftness = 0.5
			Lighting.Ambient = Color3.fromRGB(128, 128, 128)
			Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
			Lighting.FogColor = Color3.fromRGB(255, 255, 255)
			Lighting.FogStart = 0
			Lighting.FogEnd = 100000
		end
	end)

	CreateSection(tabFrames["Global Sounds"], "Preset Sound Effects")
	local soundList = {
		["Scream"] = 138081500,
		["Explosion"] = 138186576,
		["Siren"] = 9114373430,
		["Horn"] = 5153734236,
		["Laugh"] = 13114759,
		["Jumpscare"] = 91784486966761
	}
	local presetNames = { "Scream", "Explosion", "Siren", "Horn", "Laugh", "Jumpscare" }
	local selectedSoundName = "Scream"

	CreateDropdown(tabFrames["Global Sounds"], "Preset Sound", presetNames, "Scream", function(opt)
		selectedSoundName = opt
	end)

	local function playSoundById(soundId)
		if not soundId then
			return
		end
		pcall(function()
			local re = ReplicatedStorage:FindFirstChild("RE")
			local gunSound = re and re:FindFirstChild("1Gu1nSound1s")
			if gunSound then
				gunSound:FireServer(workspace, soundId, 1)
			end
			local snd = Instance.new("Sound", workspace)
			snd.SoundId = "rbxassetid://" .. tostring(soundId)
			snd.Volume = 1
			snd:Play()
			task.delay(3, function()
				if snd then
					snd:Destroy()
				end
			end)
		end)
	end

	local loopPresetActive = false
	CreateButton(tabFrames["Global Sounds"], "▶ Play Preset Sound", function()
		playSoundById(soundList[selectedSoundName])
	end)

	CreateToggle(tabFrames["Global Sounds"], "Loop Preset Sound", function(state)
		loopPresetActive = state
		if state then
			task.spawn(function()
				while loopPresetActive do
					playSoundById(soundList[selectedSoundName])
					task.wait(1.5)
				end
			end)
		end
	end)

	CreateSection(tabFrames["Global Sounds"], "Custom Audio ID All")
	local customAudioId = nil
	local loopCustomAudio = false

	CreateTextBox(tabFrames["Global Sounds"], "Custom Sound ID", "Ex: 6832470734", function(txt)
		customAudioId = tonumber(txt)
	end)

	CreateButton(tabFrames["Global Sounds"], "▶ Play Custom Audio ID", function()
		if customAudioId then
			playSoundById(customAudioId)
		else
			notify("Enter a valid numeric Sound ID!")
		end
	end)

	CreateToggle(tabFrames["Global Sounds"], "Loop Custom Audio ID", function(state)
		loopCustomAudio = state
		if state then
			task.spawn(function()
				while loopCustomAudio do
					if customAudioId then
						playSoundById(customAudioId)
					end
					task.wait(1.5)
				end
			end)
		end
	end)

	CreateSection(tabFrames.Scripts, "Brookhaven & Universal Hubs")
	local externalScripts = {
		{ name = "Dark Hub", url = "https://scriptsbinsauth.vercel.app/api/scripts/70e0bd6e-0b4e-4d1b-9757-b355c17fefde/raw" },
		{ name = "Tyger X", url = "https://rawscripts.net/raw/Brookhaven-RP-Tiger-X-39488" },
		{ name = "Gumball Hub", url = "https://raw.githubusercontent.com/JaozinScripts/Gumball-Hub/refs/heads/main/GumballHubRetorn2.1.1.1.lua" },
		{ name = "Kakah Hub Brookhaven", url = "https://pastefy.app/dD1VgsS6/raw" },
		{ name = "Infinite Yield", url = "https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source" },
		{ name = "Rochips Universal", url = "https://rawscripts.net/raw/Universal-Script-rochips-universal-18294" },
		{ name = "Sander X", url = "https://raw.githubusercontent.com/kigredns/SanderXV4.2.2/refs/heads/main/New.lua" },
		{ name = "System Broken", url = "https://raw.githubusercontent.com/H20CalibreYT/SystemBroken/main/script" },
		{ name = "Anti Lag V2", url = "https://pastebin.com/raw/ureZEHue" },
		{ name = "Fly Gui V3", url = "https://scriptblox.com/raw/Universal-Script-Fly-v3-7412" }
	}

	for _, sc in ipairs(externalScripts) do
		CreateButton(tabFrames.Scripts, sc.name, function()
			notify("Loading " .. sc.name .. "...")
			pcall(function()
				loadstring(game:HttpGet(sc.url, true))()
			end)
		end)
	end
end

loadMainGui()
