	local function addCyberStroke(obj)
		local stroke = Instance.new("UIStroke", obj)
		stroke.Thickness = 3
		stroke.LineJoinMode = Enum.LineJoinMode.Round
		local t = 0
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			if not obj or not obj.Parent then
				conn:Disconnect()
				return
			end
			t = t + dt * 2
			local alpha = (math.sin(t) + 1) / 2
			stroke.Color = Color3.fromRGB(0, 255, 255):Lerp(Color3.fromRGB(255, 0, 128), alpha)
		end)
	end

	local miniCircle = nil
	local isMinimized = false

	local function createMiniCircle()
		if miniCircle then
			return
		end
		miniCircle = Instance.new("ImageButton", screenGui)
		miniCircle.Name = "MiniCircle"
		miniCircle.Size = UDim2.new(0, 48, 0, 48)
		miniCircle.Position = UDim2.new(0, 10, 0.5, -24)
		miniCircle.BackgroundColor3 = Color3.fromRGB(16, 14, 32)
		miniCircle.BackgroundTransparency = 0
		miniCircle.Image = "rbxassetid://0"

		pcall(function()
			if writefile and getcustomasset then
				local imgPath = folderName .. "/mini_icon.jpg"
				if not isfile(imgPath) then
					local data = game:HttpGet("https://i.ibb.co/VYQTJFp0/IMG-20250812-184530.jpg")
					writefile(imgPath, data)
				end
				miniCircle.Image = getcustomasset(imgPath)
			end
		end)

		local cCorner = Instance.new("UICorner", miniCircle)
		cCorner.CornerRadius = UDim.new(1, 0)

		addCyberStroke(miniCircle)
		makeDraggable(miniCircle, miniCircle)

		miniCircle.MouseButton1Click:Connect(function()
			isMinimized = false
			if miniCircle then
				miniCircle:Destroy()
				miniCircle = nil
			end
			mainFrame.Visible = true
			local tInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(mainFrame, tInfo, { Size = UDim2.new(0, 560, 0, 360) }):Play()
		end)
	end

	minBtn.MouseButton1Click:Connect(function()
		isMinimized = not isMinimized
		if isMinimized then
			mainFrame.Visible = false
			createMiniCircle()
		else
			if miniCircle then
				miniCircle:Destroy()
				miniCircle = nil
			end
			mainFrame.Visible = true
		end
	end)

