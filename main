	CreateButton(tabFrames.Home, "Unban all houses", function()
		local lots = workspace:FindFirstChild("001_Lots")
		if not lots then
			notify("Error: 01")
			return
		end

		local count = 0
		for _, lot in ipairs(lots:GetChildren()) do
			local picked = lot:FindFirstChild("HousePickedByPlayer")
			if picked then
				local model = picked:FindFirstChild("HouseModel")
				if model then
					local banBlock = model:FindFirstChild("BannedBlock")
					if banBlock then
						banBlock:Destroy()
						count = count + 1
					end
				end
			end
		end

		if count > 0 then
			notify(tostring(count) .. " unbanned houses.")
		else
			notify("No banned houses found.")
		end
	end)

