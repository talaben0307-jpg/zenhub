	local function playSelectedSound()
		pcall(function()
			local re = ReplicatedStorage:FindFirstChild("RE")
			local gunSound = re and re:FindFirstChild("1Gu1nSound1s")
			local soundId = soundList[selectedSoundName]
			if gunSound and soundId then
				gunSound:FireServer(workspace, soundId, 1)
			end
		end)
	end

	local loopSoundActive = false
	local loopThread = nil

	CreateButton(tabFrames["Global Sounds"], "▶ Play Sound", function()
		if loopSoundActive then
			if loopThread then
				task.cancel(loopThread)
			end
			loopThread = task.spawn(function()
				while loopSoundActive do
					playSelectedSound()
					task.wait(3)
				end
			end)
		else
			playSelectedSound()
		end
	end)

	CreateToggle(tabFrames["Global Sounds"], "Loop Sound", function(state)
		loopSoundActive = state
		if state then
			notify("Loop enabled")
		else
			if loopThread then
				task.cancel(loopThread)
				loopThread = nil
			end
			notify("Loop stopped")
		end
	end)

	CreateButton(tabFrames.Scripts, "Dark Hub", function()
		notify("Loading script...")
		pcall(function()
			loadstring(game:HttpGet("https://scriptsbinsauth.vercel.app/api/scripts/70e0bd6e-0b4e-4d1b-9757-b355c17fefde/raw"))()
		end)
	end)

	CreateButton(tabFrames.Scripts, "Tyger X", function()
		notify("Loading script...")
		pcall(function()
			loadstring(game:HttpGet("https://rawscripts.net/raw/Brookhaven-RP-Tiger-X-39488"))()
		end)
	end)

	CreateButton(tabFrames.Scripts, "Gumball Hub", function()
		notify("Loading script...")
		pcall(function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/JaozinScripts/Gumball-Hub/refs/heads/main/GumballHubRetorn2.1.1.1.lua"))()
		end)
	end)

	CreateButton(tabFrames.Scripts, "Kakah Hub Brookhaven", function()
		notify("Loading script...")
		pcall(function()
			loadstring(game:HttpGet("https://pastefy.app/dD1VgsS6/raw"))()
		end)
	end)
end

loadMainGui()
