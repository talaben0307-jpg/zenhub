		noBtn.Size = UDim2.new(0.45, -10, 0, 35)
		noBtn.Position = UDim2.new(0.5, 10, 0.65, 0)
		noBtn.ZIndex = 1001

		local noCorner = Instance.new("UICorner", noBtn)
		noCorner.CornerRadius = UDim.new(0, 8)

		local tInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(overlay, tInfo, { BackgroundTransparency = 0.4 }):Play()
		TweenService:Create(dialog, tInfo, { BackgroundTransparency = 0 }):Play()

		yesBtn.MouseButton1Click:Connect(function()
			local t1 = TweenService:Create(overlay, tInfo, { BackgroundTransparency = 1 })
			local t2 = TweenService:Create(dialog, tInfo, { BackgroundTransparency = 1 })
			t1:Play()
			t2:Play()
			t2.Completed:Connect(function()
				screenGui:Destroy()
			end)
		end)

		noBtn.MouseButton1Click:Connect(function()
			local t1 = TweenService:Create(overlay, tInfo, { BackgroundTransparency = 1 })
			local t2 = TweenService:Create(dialog, tInfo, { BackgroundTransparency = 1 })
			t1:Play()
			t2:Play()
